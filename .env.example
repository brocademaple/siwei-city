# Local dev can use the built-in Vite /api/deepseek/chat middleware.
# Production/GitHub Pages should point this to your deployed Vercel function.
VITE_DEEPSEEK_PROXY_URL=/api/deepseek/chat
VITE_DEEPSEEK_INPUT_PRICE_CNY_PER_1K=0
VITE_DEEPSEEK_OUTPUT_PRICE_CNY_PER_1K=0

# Put these in .env.local for local dev, and in Vercel project environment variables for production.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_INPUT_PRICE_CNY_PER_1K=0
# DEEPSEEK_OUTPUT_PRICE_CNY_PER_1K=0
