# Local dev can use the built-in Vite /api/mimo/chat middleware.
# Production/GitHub Pages should point this to your deployed Vercel function.
VITE_MIMO_PROXY_URL=/api/mimo/chat
VITE_MIMO_INPUT_PRICE_CNY_PER_1K=0
VITE_MIMO_OUTPUT_PRICE_CNY_PER_1K=0

# Put these in .env.local for local dev, and in Vercel project environment variables for production.
# MIMO_API_KEY=
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_INPUT_PRICE_CNY_PER_1K=0
# MIMO_OUTPUT_PRICE_CNY_PER_1K=0
